{
  "name": "oxfmt-next-line",
  "version": "0.73.0",
  "description": "Oxfmt with opening braces on the next line",
  "keywords": [
    "braces",
    "formatter",
    "javascript",
    "next-line",
    "oxc",
    "oxfmt",
    "prettier",
    "typescript"
  ],
  "homepage": "https://github.com/motlin/oxc-next-line/tree/next-line-braces/npm/oxfmt#readme",
  "bugs": "https://github.com/motlin/oxc-next-line/issues",
  "license": "MIT",
  "author": "Craig P. Motlin, Boshen and oxc contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/motlin/oxc-next-line",
    "directory": "npm/oxfmt"
  },
  "bin": {
    "oxfmt": "bin/oxfmt",
    "oxfmt-next-line": "bin/oxfmt"
  },
  "files": [
    "configuration_schema.json",
    "dist",
    "README.md",
    "bin/oxfmt"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "tinypool": "2.2.0"
  },
  "peerDependencies": {
    "@astrojs/compiler-rs": "^0.4.0 || ^0.5.0",
    "svelte": "^5.0.0",
    "vite-plus": "*"
  },
  "peerDependenciesMeta": {
    "@astrojs/compiler-rs": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  },
  "napi": {
    "binaryName": "oxfmt",
    "packageName": "oxfmt-next-line-binding",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-linux-android",
      "aarch64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "aarch64-unknown-linux-ohos",
      "armv7-linux-androideabi",
      "armv7-unknown-linux-gnueabihf",
      "armv7-unknown-linux-musleabihf",
      "i686-pc-windows-msvc",
      "powerpc64le-unknown-linux-gnu",
      "riscv64gc-unknown-linux-gnu",
      "riscv64gc-unknown-linux-musl",
      "s390x-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-freebsd",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "preferUnplugged": true
}
